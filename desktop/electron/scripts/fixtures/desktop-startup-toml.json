    "toml": "value = { outer = { enabled = true }, list = [1, 2,], empty = {} }\n",
    "defer": false,
    "pythonAccepts": true
  },
  {
    "name": "inline quoted keys",
    "toml": "value = { '中文' = { \"路径\" = '目录' } }\n",
    "defer": false,
    "pythonAccepts": true
  },
  {
    "name": "inline punctuation values",
    "toml": "value = { text = \"{},#[]\", literal = '{},#[]\\e\\x' }\n",
    "defer": false,
    "pythonAccepts": true
  },
  {
    "name": "multiline array",
    "toml": "value = [\n{ key = 1 }, # {} \\e 中文\n{ key = [2, 3,] },\n]\n",
    "defer": false,
    "pythonAccepts": true
  },
  {
    "name": "multiline basic",
