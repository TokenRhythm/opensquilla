[
  {
    "name": "default",
    "toml": "config_version = 2\n",
    "defer": false,
    "pythonAccepts": true
  },
  {
    "name": "comment syntax",
    "toml": "# {} [中文] bare键 = x \\e \\x1b\nconfig_version = 2\n",
    "defer": false,
    "pythonAccepts": true
  },
  {
    "name": "basic string syntax",
    "toml": "value = \"中文 {} # quoted \\\" [not a table]\"\n",
    "defer": false,
    "pythonAccepts": true
  },
  {
    "name": "literal string syntax",
    "toml": "value = '中文 {} # \\e \\x1b'\n",
    "defer": false,
    "pythonAccepts": true
  },
  {
    "name": "escaped backslash",
    "toml": "value = \"\\\\e \\\\x1b \\\\\\\\e\"\n",
    "defer": false,
    "pythonAccepts": true
  },
  {
    "name": "unicode escapes",
    "toml": "\"\\u4e2d\\u6587\" = \"\\u007b\\U0001f642\\u007d\"\n",
    "defer": false,
    "pythonAccepts": true
  },
  {
    "name": "quoted keys",
    "toml": "\"中文\" = '值'\n['带点.和括号{}']\n\"数据目录\" = '目录'\n",
    "defer": false,
    "pythonAccepts": true
  },
  {
    "name": "quoted dotted keys",
    "toml": "\"中文\".'字段' = 1\n",
    "defer": false,
    "pythonAccepts": true
