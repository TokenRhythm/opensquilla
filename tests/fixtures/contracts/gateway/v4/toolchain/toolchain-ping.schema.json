{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/testing/v4/toolchain-ping.schema.json",
  "title": "Gateway Contract runner integration fixture",
  "type": "object",
  "additionalProperties": false,
  "x-opensquilla-wire": {
    "protocol": "opensquilla-websocket-json",
    "version": 4,
    "compatibility": "exact-json-tree"
  },
  "x-opensquilla-codegen": {
    "python": {
      "tool": "datamodel-code-generator",
      "version": "0.75.1",
      "target": "pydantic_v2.BaseModel"
    },
    "typescript": {
      "tool": "json-schema-to-typescript",
      "version": "15.0.4"
    },
    "runtimeValidation": {
      "tool": "ajv",
      "version": "8.17.1",
      "mode": "standalone-adapter-only"
    }
  },
  "x-opensquilla-method": {
    "name": "toolchain.ping",
    "kind": "query",
    "scope": "operator.read",
    "guestAllowed": false,
    "idempotency": "read-only",
    "timeout": {
      "policy": "caller"
    },
    "capability": {
      "kind": "method-availability",
      "name": "toolchain.ping"
    },
    "errors": [
      {
        "code": "INVALID_PARAMS"
      }
    ],
    "request": "#/$defs/ToolchainPingRequestFrame",
    "params": "#/$defs/ToolchainPingParams",
    "response": "#/$defs/ToolchainPingResponseFrame",
    "result": "#/$defs/ToolchainPingResult"
  },
  "$defs": {
    "ToolchainPingParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ToolchainPingRequestFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "type": {
          "const": "req"
        },
        "id": {
          "type": "string"
        },
        "method": {
          "const": "toolchain.ping"
        },
        "params": {
          "$ref": "#/$defs/ToolchainPingParams"
        }
      }
    },
    "ToolchainPingResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "echoed"
      ],
      "properties": {
        "echoed": {
          "type": "string"
        }
      }
    },
    "ToolchainPingResponseFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "ok",
        "payload"
      ],
      "properties": {
        "type": {
          "const": "res"
        },
        "id": {
          "type": "string"
        },
        "ok": {
          "const": true
        },
        "payload": {
          "$ref": "#/$defs/ToolchainPingResult"
        }
      }
    }
  }
}
