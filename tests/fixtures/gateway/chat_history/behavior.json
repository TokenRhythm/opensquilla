{
  "format_version": 1,
  "kind": "behavior",
  "cases": [
    {
      "id": "behavior.alias-forwarding",
      "request_case": "request.aliases",
      "assert": "response.active-page",
      "notes": [
        "the v4 handler accepts the established camelCase history fields",
        "includeCanonical=false selects the active transcript reader",
        "includeSummaries=false suppresses optional summary reads"
      ]
    },
    {
      "id": "behavior.before-precedence",
      "request_case": "request.before-after",
      "assert": "response.before-wins",
      "notes": ["before cursor wins when both before and after are supplied"]
    },
    {
      "id": "behavior.limit-normalization",
      "request_cases": [
        "request.limit-zero",
        "request.limit-string"
      ],
      "asserts": [
        "response.limit-clamped",
        "response.limit-defaulted"
      ]
    },
    {
      "id": "behavior.missing-session-policy",
      "request_cases": [
        "request.default-null",
        "request.missing-non-webchat"
      ],
      "asserts": [
        "response.missing-webchat",
        "error.missing-non-webchat"
      ]
    },
    {
      "id": "behavior.error-envelope",
      "request_cases": [
        "request.invalid-truthy-params",
        "request.storage-busy"
      ],
      "asserts": [
        "error.invalid-truthy-params",
        "error.storage-busy"
      ]
    }
  ]
}
