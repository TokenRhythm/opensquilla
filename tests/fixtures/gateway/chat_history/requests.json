        "method": "chat.history",
        "params": null
      },
      "expected_outcome": "response.missing-webchat"
    },
    {
      "id": "request.aliases",
      "wire": {
        "type": "req",
        "id": "request.aliases",
        "method": "chat.history",
        "params": {
          "sessionKey": "agent:main:webchat:characterization",
          "limit": 2,
          "includeCanonical": false,
          "includeSummaries": false
        }
      },
      "expected_outcome": "response.active-page"
    },
    {
      "id": "request.before-after",
      "wire": {
        "type": "req",
        "id": "request.before-after",
        "method": "chat.history",
        "params": {
          "sessionKey": "agent:main:webchat:characterization",
          "limit": 2,
          "before": "3|3",
          "after": "1|1"
        }
      },
      "expected_outcome": "response.before-wins"
    },
    {
      "id": "request.limit-zero",
      "wire": {
        "type": "req",
        "id": "request.limit-zero",
        "method": "chat.history",
        "params": {
          "sessionKey": "agent:main:webchat:characterization",
          "limit": 0
        }
      },
      "expected_outcome": "response.limit-clamped"
    },
    {
