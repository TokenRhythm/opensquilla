{
  "name": "opensquilla-webui",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "predev": "node scripts/patch-generative-frame.mjs",
    "dev": "node scripts/prepare-office-preview-assets.mjs && vite",
    "prepare:office-assets": "node scripts/prepare-office-preview-assets.mjs",
    "test:office-assets": "node --test scripts/prepare-office-preview-assets.test.mjs",
    "build": "npm run typecheck && npm run build:artifact",
    "prebuild:artifact": "node scripts/patch-generative-frame.mjs && npm run visualize:guidance:check",
    "build:artifact": "node scripts/prepare-office-preview-assets.mjs && vite build && node scripts/normalize-dist.mjs && node scripts/check-theme-bundle.mjs && node scripts/check-runtime-bundle.mjs && node scripts/verify-dist.mjs --write && node scripts/stage-dist.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:release-dist": "node scripts/verify-dist.mjs",
    "preview": "vite preview",
    "check:architecture": "node scripts/check-architecture.mjs && npm run check:rpc-architecture && node scripts/check-chat-security.mjs && node scripts/check-webui-colors.mjs && node scripts/check-webui-motion.mjs && node scripts/check-webui-radius.mjs && node scripts/check-theme-contract.mjs && node scripts/check-theme-scope.mjs && node scripts/check-cross-surface-tokens.mjs && node scripts/check-i18n.mjs && node scripts/check-channel-catalog-i18n.mjs && node scripts/check-readme-locales.mjs",
    "check:rpc-architecture": "node scripts/lib/rpc-architecture-gate.mjs && node ../scripts/contracts/check_gateway_production_targets.mjs",
    "test:contract-tooling": "node --test ../scripts/contracts/tests/*.test.mjs",
    "check:readme-locales": "node scripts/check-readme-locales.mjs",
    "typecheck": "npm run check:architecture && npm run typecheck:config && npm run typecheck:vue",
    "typecheck:config": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.node.json",
    "typecheck:vue": "node scripts/typecheck-vue.mjs --noEmit",
    "pretest:unit": "node scripts/patch-generative-frame.mjs && node scripts/prepare-office-preview-assets.mjs --offline",
    "test:visualize-patch": "node --test scripts/patch-generative-frame.test.mjs",
    "visualize:guidance:write": "node scripts/sync-visualize-guidance.mjs --write",
    "visualize:guidance:check": "node scripts/sync-visualize-guidance.mjs --check",
    "test:visualize-guidance": "node --test scripts/sync-visualize-guidance.test.mjs",
    "test:unit": "vitest run",
    "pretest:unit:watch": "node scripts/patch-generative-frame.mjs && node scripts/prepare-office-preview-assets.mjs --offline",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:image-copy": "playwright test --config playwright.image-copy.config.ts",
    "test:e2e:message-copy": "playwright test --config playwright.message-copy.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@silurus/ooxml": "0.88.0",
    "@tanstack/vue-virtual": "3.13.39",
    "@viz-js/viz": "3.31.0",
    "@vue/devtools-api": "^8.2.1",
    "dompurify": "^3.4.16",
    "generative-frame": "0.0.5",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "katex": "^0.19.0",
    "marked": "^18.1.0",
    "mermaid": "^11.17.2",
    "papaparse": "5.5.3",
    "parse5": "8.0.1",
    "pdfjs-dist": "5.4.296",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.4.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/papaparse": "5.3.16",
    "@types/ws": "^8.18.2",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "ajv": "8.20.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "^20.14.5",
    "json-schema-to-typescript": "16.0.0",
    "json-schema-to-typescript-legacy": "npm:json-schema-to-typescript@15.0.4",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12",
    "ws": "^8.22.0"
  }
}
