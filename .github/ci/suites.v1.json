{
  "schema_version": 1,
  "windows_test_assignments": ".github/scripts/windows_test_assignments.json",
  "macos_recovery_test_inputs": [
    "tests/test_recovery/**",
    "tests/test_migration/test_opensquilla_home_migration.py",
    "tests/test_desktop/test_electron_startup_contract.py"
  ],
  "baseline_suites": [
    "readme-locale",
    "workflow-lint"
  ],
  "full_suites": [
    "desktop-recovery-e2e",
    "desktop-static",
    "frontend-artifact",
    "frontend-validation",
    "macos-recovery",
    "managed-toolchain",
    "python-full",
    "readme-locale",
    "release-packaging",
    "skill-hub",
    "tui",
    "webui-chat-recovery",
    "wheel-webui-roundtrip",
    "windows-high-risk",
    "workflow-lint"
  ],
  "full_desktop_matrix": [
    {
      "os": "ubuntu-latest",
      "shard": "all"
    },
    {
      "os": "macos-latest",
      "shard": "profiles"
    },
    {
      "os": "macos-latest",
      "shard": "ownership"
    },
    {
      "os": "macos-latest",
      "shard": "workbench"
    },
    {
      "os": "windows-latest",
      "shard": "profiles"
    },
    {
      "os": "windows-latest",
      "shard": "ownership"
    },
    {
      "os": "windows-latest",
      "shard": "workbench"
    }
  ],
  "full_python_matrix": {
    "ubuntu": [
      "core",
      "gateway-sqlite",
      "recovery-migration",
      "desktop-installer-contracts"
    ],
    "windows": [
      "core",
      "gateway-sqlite",
      "recovery-migration",
      "desktop-installer-contracts"
    ]
  },
