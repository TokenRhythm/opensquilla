# OpenSquilla API Keys
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Required — LLM provider (OpenRouter)
OPENROUTER_API_KEY=

# Optional — TokenRhythm aggregator (DeepSeek/GLM/MiniMax/Kimi families)
TOKENRHYTHM_API_KEY=

# Optional — Brave Search API (auto-selected over DuckDuckGo when set)
# Get a key at https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Optional — Web search network proxy.
# Use this when Brave/DuckDuckGo endpoints are not reachable directly.
# This affects web_search only; LLM provider proxy is configured separately.
OPENSQUILLA_GATEWAY_SEARCH_PROXY=

# Optional — allow web_search providers to use HTTP_PROXY/HTTPS_PROXY when no
# explicit search proxy is set. Defaults to false for predictable behavior.
OPENSQUILLA_GATEWAY_SEARCH_USE_ENV_PROXY=false

# Optional — honor HTTP_PROXY/HTTPS_PROXY/ALL_PROXY for outbound HTTP clients
# (channels, providers, web_fetch, http_request). Off by default so a stray
# proxy in a parent shell cannot silently reroute agent traffic. Set to 1 on
# WSL2, corporate, or censored networks where a local proxy is the only route
# to the public internet. web_fetch keeps DNS pinning by default.
# OPENSQUILLA_TRUST_ENV=1

# Optional — let an applicable environment proxy resolve web_fetch hostnames.
# Requires OPENSQUILLA_TRUST_ENV=1. OFF by default: enabling this delegates
# final destination access control to the proxy; local checks cannot prevent
# proxy-side DNS rebinding into private networks. Use only with a proxy whose
# destination policy you trust. NO_PROXY/direct and managed routes are unchanged.
# OPENSQUILLA_WEB_FETCH_TRUST_PROXY_DNS=1
