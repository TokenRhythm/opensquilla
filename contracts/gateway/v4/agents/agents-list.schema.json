{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/agents/agents-list.schema.json",
  "title": "OpenSquilla agents.list Contract",
  "type": "object", "additionalProperties": false,
  "properties": { "request": { "$ref": "#/$defs/Request" }, "response": { "$ref": "#/$defs/Response" } },
  "x-opensquilla-wire": { "protocol": "opensquilla-websocket-json", "version": 4, "compatibility": "exact-json-tree" },
  "x-opensquilla-codegen": {
    "python": { "tool": "datamodel-code-generator", "version": "0.75.1", "target": "pydantic_v2.BaseModel" },
    "typescript": { "tool": "json-schema-to-typescript", "version": "15.0.4" },
    "runtimeValidation": { "tool": "ajv", "version": "8.17.1", "mode": "standalone-adapter-only" }
  },
  "x-opensquilla-method": {
    "name": "agents.list", "kind": "query", "scope": "operator.read", "guestAllowed": false,
    "idempotency": "read-only", "timeout": { "policy": "caller" },
    "capability": { "kind": "method-availability", "name": "agents.list" },
    "request": "#/$defs/Request", "params": "#/$defs/Params", "response": "#/$defs/Response", "result": "#/$defs/Result",
    "errors": [{ "code": "INVALID_REQUEST" }, { "code": "UNAUTHORIZED" }, { "code": "UNAVAILABLE", "retryable": true }, { "code": "INTERNAL_ERROR" }]
  },
  "$defs": {
    "Agent": {
      "type": "object", "additionalProperties": true, "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string" }, "type": { "type": ["string", "null"] },
        "isBuiltin": { "type": ["boolean", "null"] }, "description": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] }, "tools": { "type": ["array", "null"], "items": { "type": "string" } },
        "skills": { "type": ["array", "null"], "items": { "type": "string" } }, "workspace": { "type": ["string", "null"] },
        "agentDir": { "type": ["string", "null"] }, "enabled": { "type": ["boolean", "null"] },
        "systemPrompt": { "type": ["string", "null"] }, "subagents": { "type": ["object", "null"], "additionalProperties": true }
      }
    },
    "Params": { "type": "object", "additionalProperties": true, "properties": { "includeBuiltin": { "type": ["boolean", "null"] } } },
    "Request": { "type": "object", "additionalProperties": false, "required": ["type", "id", "method"], "properties": { "type": { "const": "req" }, "id": { "type": "string" }, "method": { "const": "agents.list" }, "params": { "anyOf": [{ "$ref": "#/$defs/Params" }, { "type": "null" }] } } },
    "Result": { "type": "object", "additionalProperties": false, "required": ["agents"], "properties": { "agents": { "type": "array", "items": { "$ref": "#/$defs/Agent" } } } },
    "RpcError": { "type": "object", "additionalProperties": true, "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "details": {}, "retryable": { "type": ["boolean", "null"] } } },
    "Ok": { "type": "object", "additionalProperties": false, "required": ["type", "id", "ok", "payload"], "properties": { "type": { "const": "res" }, "id": { "type": "string" }, "ok": { "const": true }, "payload": { "$ref": "#/$defs/Result" }, "error": { "type": "null" } } },
    "Err": { "type": "object", "additionalProperties": false, "required": ["type", "id", "ok", "error"], "properties": { "type": { "const": "res" }, "id": { "type": "string" }, "ok": { "const": false }, "payload": { "type": "null" }, "error": { "$ref": "#/$defs/RpcError" } } },
    "Response": { "oneOf": [{ "$ref": "#/$defs/Ok" }, { "$ref": "#/$defs/Err" }] }
  }
}
