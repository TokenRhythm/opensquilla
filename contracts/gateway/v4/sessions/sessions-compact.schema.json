{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/sessions/sessions-compact.schema.json",
  "title": "OpenSquilla sessions.compact legacy Contract",
  "description": "Language-neutral Contract for the legacy v4 compact alias. Canonical and legacy names share one Application implementation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": { "$ref": "#/$defs/SessionsCompactRequestFrame" },
    "response": { "$ref": "#/$defs/SessionsCompactResponseFrame" }
  },
  "x-opensquilla-wire": { "protocol": "opensquilla-websocket-json", "version": 4, "compatibility": "exact-json-tree" },
  "x-opensquilla-codegen": {
    "python": { "tool": "datamodel-code-generator", "version": "0.75.1", "target": "pydantic_v2.BaseModel" },
    "typescript": { "tool": "json-schema-to-typescript", "version": "15.0.4" },
    "runtimeValidation": { "tool": "ajv", "version": "8.17.1", "mode": "standalone-adapter-only" }
  },
  "x-opensquilla-method": {
    "name": "sessions.compact", "kind": "command", "scope": "operator.write", "guestAllowed": false,
    "idempotency": "non-idempotent", "timeout": { "policy": "caller" },
    "capability": { "kind": "method-availability", "name": "sessions.compact" },
    "request": "#/$defs/SessionsCompactRequestFrame", "params": "#/$defs/SessionsCompactParams",
    "response": "#/$defs/SessionsCompactResponseFrame", "result": "#/$defs/SessionsCompactResult",
    "errors": [
      { "code": "INVALID_PARAMS" }, { "code": "NOT_FOUND" }, { "code": "UNAUTHORIZED" },
      { "code": "CONTEXT_FLUSH_FAILED", "retryable": true, "details": true },
      { "code": "COMPACTION_TIMEOUT", "retryable": true, "details": true }, { "code": "INTERNAL_ERROR" }
    ]
  },
  "$defs": {
    "SessionsCompactParams": {
      "type": "object", "additionalProperties": true, "required": ["key"],
      "properties": {
        "key": { "type": "string", "minLength": 1 }, "wait": { "type": "boolean", "default": true },
        "contextWindowTokens": { "type": "integer", "minimum": 1 },
        "context_window_tokens": { "type": "integer", "minimum": 1 }, "instructions": { "type": "string" }
      }
    },
    "SessionsCompactRequestFrame": {
      "type": "object", "additionalProperties": false, "required": ["type", "id", "method"],
      "properties": { "type": { "const": "req" }, "id": { "type": "string" }, "method": { "const": "sessions.compact" }, "params": {} }
    },
    "SessionsCompactResult": {
      "type": "object", "additionalProperties": true,
      "required": ["key", "compaction_id", "status", "compacted", "applied", "durability", "user_visible"],
      "properties": {
        "key": { "type": "string" }, "compaction_id": { "type": "string" }, "status": { "type": "string" },
        "compacted": { "type": "boolean" }, "applied": { "type": "boolean" }, "durability": { "type": "string" },
        "user_visible": { "type": "boolean" }, "mode": { "type": "string" }, "summary_len": { "type": "integer" },
        "summary_source": { "type": "string" }, "context_window_tokens": { "type": "integer" },
        "tokens_before": { "type": "integer" }, "tokens_after": { "type": "integer" },
        "remaining_budget_tokens": { "type": "integer" }, "removed_count": { "type": "integer" },
        "kept_count": { "type": "integer" }, "chunk_count": { "type": "integer" },
        "coverage_status": { "type": "string" }, "missing_obligation_count": { "type": "integer" },
        "critical_carry_forward_count": { "type": "integer" }, "state_kind": { "type": "string" },
        "quality_report": { "type": "object", "additionalProperties": true }, "skip_reason": { "type": "string" },
        "reason": { "type": "string" }, "flush_receipt": { "type": ["object", "null"], "additionalProperties": true },
        "flush_receipt_status": { "type": ["string", "null"] }
      }
    },
    "RpcError": { "type": "object", "additionalProperties": true, "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } },
    "SessionsCompactOkResponseFrame": {
      "type": "object", "additionalProperties": false, "required": ["type", "id", "ok", "payload"],
      "properties": { "type": { "const": "res" }, "id": { "type": "string" }, "ok": { "const": true }, "payload": { "$ref": "#/$defs/SessionsCompactResult" }, "error": { "type": "null" } }
    },
    "SessionsCompactErrorResponseFrame": {
      "type": "object", "additionalProperties": false, "required": ["type", "id", "ok", "error"],
      "properties": { "type": { "const": "res" }, "id": { "type": "string" }, "ok": { "const": false }, "payload": { "type": "null" }, "error": { "$ref": "#/$defs/RpcError" } }
    },
    "SessionsCompactResponseFrame": { "oneOf": [{ "$ref": "#/$defs/SessionsCompactOkResponseFrame" }, { "$ref": "#/$defs/SessionsCompactErrorResponseFrame" }] }
  }
}
