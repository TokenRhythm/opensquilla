{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/sessions/sessions-preview.schema.json",
  "title": "OpenSquilla sessions.preview Contract",
  "description": "Language-neutral Contract for the bounded v4 session preview projection. The result never materializes a complete transcript.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": { "$ref": "#/$defs/SessionsPreviewRequestFrame" },
    "response": { "$ref": "#/$defs/SessionsPreviewResponseFrame" }
  },
  "x-opensquilla-wire": { "protocol": "opensquilla-websocket-json", "version": 4, "compatibility": "exact-json-tree" },
  "x-opensquilla-codegen": {
    "python": { "tool": "datamodel-code-generator", "version": "0.75.1", "target": "pydantic_v2.BaseModel" },
    "typescript": { "tool": "json-schema-to-typescript", "version": "15.0.4" },
    "runtimeValidation": { "tool": "ajv", "version": "8.17.1", "mode": "standalone-adapter-only" }
  },
  "x-opensquilla-method": {
    "name": "sessions.preview",
    "kind": "query",
    "scope": "operator.read",
    "guestAllowed": false,
    "idempotency": "read-only",
    "timeout": { "policy": "caller" },
    "capability": { "kind": "method-availability", "name": "sessions.preview" },
    "request": "#/$defs/SessionsPreviewRequestFrame",
    "params": "#/$defs/SessionsPreviewParams",
    "response": "#/$defs/SessionsPreviewResponseFrame",
    "result": "#/$defs/SessionsPreviewResult",
    "errors": [
      { "code": "INVALID_REQUEST" },
      { "code": "UNAUTHORIZED" },
      { "code": "STORAGE_BUSY", "retryable": true, "retryAfterMs": true, "details": true },
      { "code": "INTERNAL_ERROR" }
    ]
  },
  "$defs": {
    "SessionsPreviewParams": {
      "title": "sessions.preview params",
      "description": "An absent or empty keys value lists the bounded session set; otherwise previews preserve the requested key order. Unknown fields are ignored.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "keys": {
          "anyOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "null" }
          ]
        },
        "limit": { "type": ["integer", "string", "null"] }
      }
    },
    "SessionsPreviewLegacyNonObjectParams": {
      "description": "The legacy handler performs object .get calls and reports truthy non-object values through the standard error envelope.",
      "anyOf": [
        { "type": "array", "items": {} },
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "SessionsPreviewRequestFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "method"],
      "properties": {
        "type": { "const": "req" },
        "id": { "type": "string" },
        "method": { "const": "sessions.preview" },
        "params": {
          "anyOf": [
            { "$ref": "#/$defs/SessionsPreviewParams" },
            { "$ref": "#/$defs/SessionsPreviewLegacyNonObjectParams" },
            { "type": "null" }
          ]
        }
      }
    },
    "SessionPreviewItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["key", "title", "lastMessage", "updatedAt"],
      "properties": {
        "key": { "type": "string" },
        "title": { "type": "string" },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": ["number", "null"] }
      }
    },
    "SessionsPreviewResult": {
      "title": "sessions.preview result",
      "type": "object",
      "additionalProperties": true,
      "required": ["ts", "previews"],
      "properties": {
        "ts": { "type": "integer", "minimum": 0 },
        "previews": { "type": "array", "items": { "$ref": "#/$defs/SessionPreviewItem" } }
      }
    },
    "RpcError": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": {},
        "retryable": { "type": ["boolean", "null"] },
        "retry_after_ms": { "type": ["integer", "null"], "minimum": 0 },
        "accepted": { "type": ["boolean", "null"] }
      }
    },
    "SessionsPreviewOkResponseFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "ok", "payload"],
      "properties": {
        "type": { "const": "res" },
        "id": { "type": "string" },
        "ok": { "const": true },
        "payload": { "$ref": "#/$defs/SessionsPreviewResult" },
        "error": { "type": "null" }
      }
    },
    "SessionsPreviewErrorResponseFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "ok", "error"],
      "properties": {
        "type": { "const": "res" },
        "id": { "type": "string" },
        "ok": { "const": false },
        "payload": { "type": "null" },
        "error": { "$ref": "#/$defs/RpcError" }
      }
    },
    "SessionsPreviewResponseFrame": {
      "oneOf": [
        { "$ref": "#/$defs/SessionsPreviewOkResponseFrame" },
        { "$ref": "#/$defs/SessionsPreviewErrorResponseFrame" }
      ]
    }
  }
}
