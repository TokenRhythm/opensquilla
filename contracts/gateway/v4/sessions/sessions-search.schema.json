{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/sessions/sessions-search.schema.json",
  "title": "OpenSquilla sessions.search Contract",
  "description": "Language-neutral Contract for the v4 sessions.search query. Generated wire types may be imported only by Gateway adapters and Contract tests.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": { "$ref": "#/$defs/SessionsSearchRequestFrame" },
    "response": { "$ref": "#/$defs/SessionsSearchResponseFrame" }
  },
  "x-opensquilla-wire": {
    "protocol": "opensquilla-websocket-json",
    "version": 4,
    "compatibility": "exact-json-tree"
  },
  "x-opensquilla-codegen": {
    "python": { "tool": "datamodel-code-generator", "version": "0.75.1", "target": "pydantic_v2.BaseModel" },
    "typescript": { "tool": "json-schema-to-typescript", "version": "15.0.4" },
    "runtimeValidation": { "tool": "ajv", "version": "8.17.1", "mode": "standalone-adapter-only" }
  },
  "x-opensquilla-method": {
    "name": "sessions.search",
    "kind": "query",
    "scope": "operator.read",
    "guestAllowed": false,
    "idempotency": "read-only",
    "timeout": { "policy": "caller" },
    "capability": { "kind": "method-availability", "name": "sessions.search" },
