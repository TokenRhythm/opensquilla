    "SessionsSearchParams": {
      "title": "sessions.search params",
      "description": "The Gateway historically coerces query and limit values and accepts omitted or null params.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "query": { "type": ["string", "null"] },
        "limit": { "type": ["integer", "string", "boolean", "null"] }
      }
    },
    "SessionsSearchLegacyNonObjectParams": {
      "description": "v4 ReqFrame.params is Any. Legacy non-object values retain the existing empty-search behavior.",
      "anyOf": [
        { "type": "array", "items": {} },
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" }
