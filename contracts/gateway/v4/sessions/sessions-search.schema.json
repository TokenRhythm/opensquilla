    "SessionsSearchResponseFrame": {
      "oneOf": [
        { "$ref": "#/$defs/SessionsSearchOkResponseFrame" },
        { "$ref": "#/$defs/SessionsSearchErrorResponseFrame" }
      ]
    }
  }
