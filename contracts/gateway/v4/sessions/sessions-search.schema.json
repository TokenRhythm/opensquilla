        "title": { "type": "string" },
        "effectiveAgentId": { "type": ["string", "null"] },
        "surface": { "type": ["string", "null"] },
        "updatedAt": { "type": ["integer", "null"] }
      }
    },
    "SessionsSearchMessageHit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["key", "title", "role", "snippet", "createdAt"],
      "properties": {
        "key": { "type": "string" },
        "title": { "type": "string" },
        "role": {},
        "snippet": { "type": "string" },
        "createdAt": { "type": ["integer", "string", "null"] }
