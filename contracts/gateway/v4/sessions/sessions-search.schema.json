    "params": "#/$defs/SessionsSearchParams",
    "response": "#/$defs/SessionsSearchResponseFrame",
    "result": "#/$defs/SessionsSearchResult",
    "errors": [
      { "code": "UNAUTHORIZED" },
      { "code": "STORAGE_BUSY", "retryable": true, "retryAfterMs": true, "details": true },
      { "code": "INTERNAL_ERROR" }
