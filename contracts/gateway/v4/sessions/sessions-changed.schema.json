{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/sessions/sessions-changed.schema.json",
  "title": "OpenSquilla sessions.changed Contract",
  "description": "Language-neutral Contract for the v4 sessions.changed event. The canonical payload carries schema_version=1; the legacy payload intentionally omits that field so an upgraded decoder can consume events produced by older Gateways. Unknown additive fields remain part of the compatibility surface.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "payload": {
      "$ref": "#/$defs/SessionsChangedEventPayload"
    }
  },
  "x-opensquilla-wire": {
    "protocol": "opensquilla-websocket-json",
    "version": 4,
    "compatibility": "exact-json-tree"
  },
  "x-opensquilla-codegen": {
    "python": {
      "tool": "datamodel-code-generator",
      "version": "0.75.1",
      "target": "pydantic_v2.BaseModel"
    },
    "typescript": {
      "tool": "json-schema-to-typescript",
      "version": "15.0.4"
    },
    "runtimeValidation": {
      "tool": "ajv",
      "version": "8.17.1",
      "mode": "standalone-adapter-only"
    }
  },
  "x-opensquilla-event": {
    "name": "sessions.changed",
    "delivery": "live-only-best-effort",
    "schemaVersion": 1,
    "payload": "#/$defs/SessionsChangedEventPayload",
    "canonicalPayload": "#/$defs/SessionsChangedCanonicalPayload",
    "legacyPayload": "#/$defs/SessionsChangedLegacyPayload",
    "compatibility": "canonical-or-legacy"
  },
  "$defs": {
    "SessionsChangedCanonicalPayload": {
      "title": "sessions.changed canonical payload",
      "description": "Payload emitted by the current shared builder. schema_version is required and fixed at 1.",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "key",
        "reason"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "key": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "run_status": {
          "type": "string"
        }
      }
    },
    "SessionsChangedLegacyPayload": {
      "title": "sessions.changed legacy payload",
      "description": "Payload produced by older scheduler paths. It has the same required identity fields but omits schema_version.",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "key",
        "reason"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "run_status": {
          "type": "string"
        }
      },
      "not": {
        "required": [
          "schema_version"
        ]
      }
    },
    "SessionsChangedEventPayload": {
      "title": "sessions.changed event payload",
      "description": "Decoder union for current canonical and older unversioned payloads.",
      "oneOf": [
        {
          "$ref": "#/$defs/SessionsChangedCanonicalPayload"
        },
        {
          "$ref": "#/$defs/SessionsChangedLegacyPayload"
        }
      ]
    }
  }
}
