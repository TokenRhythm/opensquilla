{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/sessions/sessions-fork.schema.json",
  "title": "OpenSquilla sessions.fork Contract",
  "description": "Language-neutral Contract for the backwards-compatible v4 sessions.fork command. Request validation is observe-only so the existing handler remains the authority for legacy parameter errors; result validation fails closed on durable fork identity and through-turn acknowledgements.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": { "$ref": "#/$defs/SessionsForkRequestFrame" },
    "response": { "$ref": "#/$defs/SessionsForkResponseFrame" }
  },
  "x-opensquilla-wire": {
    "protocol": "opensquilla-websocket-json",
    "version": 4,
    "compatibility": "exact-json-tree"
  },
  "x-opensquilla-codegen": {
    "python": { "tool": "datamodel-code-generator", "version": "0.75.1", "target": "pydantic_v2.BaseModel" },
    "typescript": { "tool": "json-schema-to-typescript", "version": "15.0.4" },
    "runtimeValidation": { "tool": "ajv", "version": "8.17.1", "mode": "standalone-adapter-only" }
  },
  "x-opensquilla-method": {
    "name": "sessions.fork",
    "kind": "command",
    "scope": "operator.write",
    "guestAllowed": false,
    "idempotency": "non-idempotent",
    "timeout": { "policy": "caller" },
    "capability": { "kind": "method-availability", "name": "sessions.fork" },
    "request": "#/$defs/SessionsForkRequestFrame",
    "params": "#/$defs/SessionsForkParams",
    "response": "#/$defs/SessionsForkResponseFrame",
    "result": "#/$defs/SessionsForkResult",
    "errors": [
      { "code": "INVALID_REQUEST", "semantics": "malformed key, title, aliases, conflicting anchors, or non-terminal fork material" },
      { "code": "NOT_FOUND", "semantics": "session manager, storage, parent session, message, or turn is unavailable" },
      { "code": "UNAUTHORIZED" },
      { "code": "UNAVAILABLE", "retryable": true },
      { "code": "STORAGE_BUSY", "retryable": true, "retryAfterMs": true, "details": true },
      { "code": "INTERNAL_ERROR" }
    ]
  },
  "$defs": {
    "SessionsForkParams": {
      "title": "sessions.fork params",
      "description": "Observe-only request shape. The existing handler validates key/title types, applies first-present semantics to before-message aliases, validates all present through-turn aliases, and rejects incompatible anchors. Unknown fields remain compatible.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "key": {},
        "title": {},
        "beforeMessageId": {},
        "before_message_id": {},
        "throughTurnId": {},
        "through_turn_id": {}
      }
    },
    "SessionsForkLegacyNonObjectParams": {
      "description": "v4 ReqFrame.params is Any. Non-object values are preserved for the existing handler's INVALID_REQUEST mapping.",
      "anyOf": [
        { "type": "array", "items": {} },
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "SessionsForkRequestFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "method"],
      "properties": {
        "type": { "const": "req" },
        "id": { "type": "string" },
        "method": { "const": "sessions.fork" },
        "params": {
          "anyOf": [
            { "$ref": "#/$defs/SessionsForkParams" },
            { "$ref": "#/$defs/SessionsForkLegacyNonObjectParams" },
            { "type": "null" }
          ]
        }
      }
    },
    "SessionsForkLegacyResult": {
      "description": "Full or before-message fork acknowledgement. Null-only marker properties keep this branch disjoint from through-turn acknowledgements while preserving additive future fields.",
      "type": "object",
      "additionalProperties": true,
      "required": ["key", "parentKey"],
      "properties": {
        "key": { "type": "string" },
        "parentKey": { "type": "string" },
        "forkMode": { "type": "null" },
        "throughTurnId": { "type": "null" }
      }
    },
    "SessionsForkThroughTurnResult": {
      "description": "Capability acknowledgement proving that the terminal turn was included rather than silently falling back to a full fork.",
      "type": "object",
      "additionalProperties": true,
      "required": ["key", "parentKey", "forkMode", "throughTurnId"],
      "properties": {
        "key": { "type": "string" },
        "parentKey": { "type": "string" },
        "forkMode": { "const": "through_turn" },
        "throughTurnId": { "type": "string", "minLength": 1 }
      }
    },
    "SessionsForkResult": {
      "oneOf": [
        { "$ref": "#/$defs/SessionsForkLegacyResult" },
        { "$ref": "#/$defs/SessionsForkThroughTurnResult" }
      ]
    },
    "RpcError": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": {},
        "retryable": { "type": ["boolean", "null"] },
        "retry_after_ms": { "type": ["integer", "null"] },
        "accepted": { "type": ["boolean", "null"] }
      }
    },
    "SessionsForkOkResponseFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "ok", "payload"],
      "properties": {
        "type": { "const": "res" },
        "id": { "type": "string" },
        "ok": { "const": true },
        "payload": { "$ref": "#/$defs/SessionsForkResult" },
        "error": { "type": "null" }
      }
    },
    "SessionsForkErrorResponseFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "ok", "error"],
      "properties": {
        "type": { "const": "res" },
        "id": { "type": "string" },
        "ok": { "const": false },
        "payload": { "type": "null" },
        "error": { "$ref": "#/$defs/RpcError" }
      }
    },
    "SessionsForkResponseFrame": {
      "oneOf": [
        { "$ref": "#/$defs/SessionsForkOkResponseFrame" },
        { "$ref": "#/$defs/SessionsForkErrorResponseFrame" }
      ]
    }
  }
}
