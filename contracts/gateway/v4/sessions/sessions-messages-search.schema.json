          "maximum": 9007199254740991
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "matches": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Match"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "complete": {
          "type": "boolean",
          "description": "True only after both the frozen body range and bounded archive coverage verification have finished. Continue with next_cursor while false, including pages with no body matches."
        },
        "coverage_complete": {
          "type": "boolean",
          "description": "Cumulative proof that the canonical archive is complete and no body was unavailable. May change from false to true when incremental verification finishes; use the latest page value, not a logical AND across pages. A confirmed archive gap or unavailable body remains false."
        },
        "scanned_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unavailable_entries": {
          "type": "integer",
          "minimum": 0,
