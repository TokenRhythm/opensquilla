{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/sessions/sessions-fork-through-turn.schema.json",
  "title": "OpenSquilla sessions.forkThroughTurn Contract",
  "description": "Language-neutral Contract for the capability-safe v4 sessions.forkThroughTurn command. Request validation is observe-only so the existing handler owns legacy error semantics; successful results must prove the exact through-turn mode and anchor.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": { "$ref": "#/$defs/SessionsForkThroughTurnRequestFrame" },
    "response": { "$ref": "#/$defs/SessionsForkThroughTurnResponseFrame" }
  },
  "x-opensquilla-wire": {
    "protocol": "opensquilla-websocket-json",
    "version": 4,
    "compatibility": "exact-json-tree"
  },
  "x-opensquilla-codegen": {
    "python": { "tool": "datamodel-code-generator", "version": "0.75.1", "target": "pydantic_v2.BaseModel" },
    "typescript": { "tool": "json-schema-to-typescript", "version": "15.0.4" },
    "runtimeValidation": { "tool": "ajv", "version": "8.17.1", "mode": "standalone-adapter-only" }
  },
  "x-opensquilla-method": {
    "name": "sessions.forkThroughTurn",
    "kind": "command",
    "scope": "operator.write",
    "guestAllowed": false,
    "idempotency": "non-idempotent",
    "timeout": { "policy": "caller" },
    "capability": { "kind": "method-availability", "name": "sessions.forkThroughTurn" },
    "request": "#/$defs/SessionsForkThroughTurnRequestFrame",
    "params": "#/$defs/SessionsForkThroughTurnParams",
    "response": "#/$defs/SessionsForkThroughTurnResponseFrame",
    "result": "#/$defs/SessionsForkThroughTurnResult",
    "errors": [
      { "code": "INVALID_REQUEST", "semantics": "malformed key, title, aliases, missing through-turn anchor, before-message presence, or non-terminal fork material" },
      { "code": "NOT_FOUND", "semantics": "session manager, storage, parent session, or turn is unavailable" },
      { "code": "UNAUTHORIZED" },
      { "code": "UNAVAILABLE", "retryable": true },
      { "code": "STORAGE_BUSY", "retryable": true, "retryAfterMs": true, "details": true },
      { "code": "INTERNAL_ERROR" }
    ]
  },
  "$defs": {
    "SessionsForkThroughTurnParams": {
      "title": "sessions.forkThroughTurn params",
      "description": "Observe-only request shape. The existing handler requires key and a non-empty through-turn alias, validates all present aliases, and rejects before-message alias presence even when its value is null. Unknown fields remain compatible.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "key": {},
        "title": {},
        "beforeMessageId": {},
        "before_message_id": {},
        "throughTurnId": {},
        "through_turn_id": {}
      }
    },
    "SessionsForkThroughTurnLegacyNonObjectParams": {
      "description": "v4 ReqFrame.params is Any. Non-object values are preserved for the existing handler's INVALID_REQUEST mapping.",
      "anyOf": [
        { "type": "array", "items": {} },
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "SessionsForkThroughTurnRequestFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "method"],
      "properties": {
        "type": { "const": "req" },
        "id": { "type": "string" },
        "method": { "const": "sessions.forkThroughTurn" },
        "params": {
          "anyOf": [
            { "$ref": "#/$defs/SessionsForkThroughTurnParams" },
            { "$ref": "#/$defs/SessionsForkThroughTurnLegacyNonObjectParams" },
            { "type": "null" }
          ]
        }
      }
    },
    "SessionsForkThroughTurnResult": {
      "description": "Capability acknowledgement proving that the requested terminal turn was included.",
      "type": "object",
      "additionalProperties": true,
      "required": ["key", "parentKey", "forkMode", "throughTurnId"],
      "properties": {
        "key": { "type": "string" },
        "parentKey": { "type": "string" },
        "forkMode": { "const": "through_turn" },
        "throughTurnId": { "type": "string", "minLength": 1 }
      }
    },
    "RpcError": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": {},
        "retryable": { "type": ["boolean", "null"] },
        "retry_after_ms": { "type": ["integer", "null"] },
        "accepted": { "type": ["boolean", "null"] }
      }
    },
    "SessionsForkThroughTurnOkResponseFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "ok", "payload"],
      "properties": {
        "type": { "const": "res" },
        "id": { "type": "string" },
        "ok": { "const": true },
        "payload": { "$ref": "#/$defs/SessionsForkThroughTurnResult" },
        "error": { "type": "null" }
      }
    },
    "SessionsForkThroughTurnErrorResponseFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "ok", "error"],
      "properties": {
        "type": { "const": "res" },
        "id": { "type": "string" },
        "ok": { "const": false },
        "payload": { "type": "null" },
        "error": { "$ref": "#/$defs/RpcError" }
      }
    },
    "SessionsForkThroughTurnResponseFrame": {
      "oneOf": [
        { "$ref": "#/$defs/SessionsForkThroughTurnOkResponseFrame" },
        { "$ref": "#/$defs/SessionsForkThroughTurnErrorResponseFrame" }
      ]
    }
  }
}
