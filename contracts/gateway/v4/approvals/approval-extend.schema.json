{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/approvals/approval-extend.schema.json",
  "title": "OpenSquilla exec.approval.extend Contract",
  "description": "Language-neutral Contract for extending a legacy timed approval. The current human approval UI normally has no deadline, but the v4 route remains supported for older clients.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": { "$ref": "#/$defs/ApprovalExtendRequestFrame" },
    "response": { "$ref": "#/$defs/ApprovalExtendResponseFrame" }
  },
  "x-opensquilla-wire": {
    "protocol": "opensquilla-websocket-json",
    "version": 4,
    "compatibility": "exact-json-tree"
  },
  "x-opensquilla-codegen": {
    "python": { "tool": "datamodel-code-generator", "version": "0.75.1", "target": "pydantic_v2.BaseModel" },
    "typescript": { "tool": "json-schema-to-typescript", "version": "15.0.4" },
    "runtimeValidation": { "tool": "ajv", "version": "8.17.1", "mode": "standalone-adapter-only" }
  },
  "x-opensquilla-method": {
    "name": "exec.approval.extend",
    "kind": "command",
    "scope": "operator.approvals",
    "guestAllowed": false,
    "lifecycle": "stable",
    "idempotency": "non-idempotent",
    "timeout": { "policy": "caller" },
    "capability": { "kind": "method-availability", "name": "exec.approval.extend" },
    "compatibilityAliases": ["plugin.approval.extend"],
    "request": "#/$defs/ApprovalExtendRequestFrame",
    "params": "#/$defs/ApprovalExtendParams",
    "response": "#/$defs/ApprovalExtendResponseFrame",
    "result": "#/$defs/ApprovalExtendResult",
    "errors": [
      { "code": "INVALID_PARAMS" },
      { "code": "INVALID_REQUEST", "semantics": "missing-id-or-non-positive-seconds" },
      { "code": "UNAUTHORIZED" },
      { "code": "NOT_FOUND", "semantics": "approval-id-does-not-exist" },
      { "code": "STORAGE_BUSY", "retryable": true, "retryAfterMs": true, "details": true },
      { "code": "UNAVAILABLE", "retryable": true },
      { "code": "INTERNAL_ERROR" }
    ]
  },
  "$defs": {
    "ApprovalExtendParams": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "seconds": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    },
    "ApprovalExtendLegacyNonObjectParams": {
      "anyOf": [
        { "type": "array", "items": {} },
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "ApprovalExtendRequestFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "method"],
      "properties": {
        "type": { "const": "req" },
        "id": { "type": "string" },
        "method": { "enum": ["exec.approval.extend", "plugin.approval.extend"] },
        "params": {
          "anyOf": [
            { "$ref": "#/$defs/ApprovalExtendParams" },
            { "$ref": "#/$defs/ApprovalExtendLegacyNonObjectParams" },
            { "type": "null" }
          ]
        }
      }
    },
    "ApprovalExtendResult": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "mode", "approved", "resolved", "resolution", "deadline", "consumed", "pending"],
      "properties": {
        "id": { "type": "string" },
        "mode": { "type": "string", "enum": ["prompt", "auto-approve", "auto-deny"] },
        "approved": { "type": "boolean" },
        "resolved": { "type": "boolean" },
        "resolution": { "type": "string" },
        "deadline": { "type": ["number", "null"] },
        "consumed": { "type": "boolean" },
        "pending": { "type": "boolean" },
        "resolutionInProgress": { "type": ["boolean", "null"] }
      }
    },
    "RpcError": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": {},
        "retryable": { "type": ["boolean", "null"] },
        "retry_after_ms": { "type": ["integer", "null"], "minimum": 0 },
        "accepted": { "type": ["boolean", "null"] }
      }
    },
    "ApprovalExtendOkResponseFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "ok", "payload"],
      "properties": {
        "type": { "const": "res" },
        "id": { "type": "string" },
        "ok": { "const": true },
        "payload": { "$ref": "#/$defs/ApprovalExtendResult" },
        "error": { "type": "null" }
      }
    },
    "ApprovalExtendErrorResponseFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "ok", "error"],
      "properties": {
        "type": { "const": "res" },
        "id": { "type": "string" },
        "ok": { "const": false },
        "payload": { "type": "null" },
        "error": { "$ref": "#/$defs/RpcError" }
      }
    },
    "ApprovalExtendResponseFrame": {
      "oneOf": [
        { "$ref": "#/$defs/ApprovalExtendOkResponseFrame" },
        { "$ref": "#/$defs/ApprovalExtendErrorResponseFrame" }
      ]
    }
  }
}
