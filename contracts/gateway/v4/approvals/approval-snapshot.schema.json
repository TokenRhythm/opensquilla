{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/approvals/approval-snapshot.schema.json",
  "title": "OpenSquilla exec.approval.snapshot Contract",
  "description": "Language-neutral Contract for the v4 approval policy snapshot query. Pending approval display data is served by the HTTP snapshot and is covered by the companion fixtures; this RPC keeps its existing mode-only result.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": { "$ref": "#/$defs/ExecApprovalSnapshotRequestFrame" },
    "response": { "$ref": "#/$defs/ExecApprovalSnapshotResponseFrame" }
  },
  "x-opensquilla-wire": {
    "protocol": "opensquilla-websocket-json",
    "version": 4,
    "compatibility": "exact-json-tree"
  },
  "x-opensquilla-codegen": {
    "python": { "tool": "datamodel-code-generator", "version": "0.75.1", "target": "pydantic_v2.BaseModel" },
    "typescript": { "tool": "json-schema-to-typescript", "version": "15.0.4" },
    "runtimeValidation": { "tool": "ajv", "version": "8.17.1", "mode": "standalone-adapter-only" }
  },
  "x-opensquilla-method": {
    "name": "exec.approval.snapshot",
    "kind": "query",
    "scope": "operator.approvals",
    "guestAllowed": false,
    "idempotency": "read-only",
    "timeout": { "policy": "caller" },
    "capability": { "kind": "method-availability", "name": "exec.approval.snapshot" },
    "request": "#/$defs/ExecApprovalSnapshotRequestFrame",
    "params": "#/$defs/ExecApprovalSnapshotParams",
    "response": "#/$defs/ExecApprovalSnapshotResponseFrame",
    "result": "#/$defs/ExecApprovalSnapshotResult",
    "errors": [
      { "code": "INVALID_REQUEST", "semantics": "invalid-v4-envelope-or-legacy-params" },
      { "code": "UNAUTHORIZED" },
      { "code": "STORAGE_BUSY", "retryable": true, "retryAfterMs": true, "details": true },
      { "code": "UNAVAILABLE", "retryable": true },
      { "code": "INTERNAL_ERROR" }
    ],
    "httpCompanion": "/api/approvals"
  },
  "$defs": {
    "ExecApprovalSnapshotParams": {
      "description": "The current handler ignores params. Keep null and legacy non-object values representable so the observation adapter cannot change v4 error behavior.",
      "anyOf": [
        { "type": "object", "additionalProperties": true },
        { "type": "array", "items": {} },
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "ExecApprovalSnapshotRequestFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "method"],
      "properties": {
        "type": { "const": "req" },
        "id": { "type": "string" },
        "method": { "const": "exec.approval.snapshot" },
        "params": { "$ref": "#/$defs/ExecApprovalSnapshotParams" }
      }
    },
    "ExecApprovalSnapshotResult": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["prompt", "auto-approve", "auto-deny"] }
      }
    },
    "RpcError": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": {},
        "retryable": { "type": ["boolean", "null"] },
        "retry_after_ms": { "type": ["integer", "null"], "minimum": 0 },
        "accepted": { "type": ["boolean", "null"] }
      }
    },
    "ExecApprovalSnapshotOkResponseFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "ok", "payload"],
      "properties": {
        "type": { "const": "res" },
        "id": { "type": "string" },
        "ok": { "const": true },
        "payload": { "$ref": "#/$defs/ExecApprovalSnapshotResult" },
        "error": { "type": "null" }
      }
    },
    "ExecApprovalSnapshotErrorResponseFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "ok", "error"],
      "properties": {
        "type": { "const": "res" },
        "id": { "type": "string" },
        "ok": { "const": false },
        "payload": { "type": "null" },
        "error": { "$ref": "#/$defs/RpcError" }
      }
    },
    "ExecApprovalSnapshotResponseFrame": {
      "oneOf": [
        { "$ref": "#/$defs/ExecApprovalSnapshotOkResponseFrame" },
        { "$ref": "#/$defs/ExecApprovalSnapshotErrorResponseFrame" }
      ]
    }
  }
}
