{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/approvals/approval-resolve.schema.json",
  "title": "OpenSquilla exec.approval.resolve Contract",
  "description": "Language-neutral Contract for an approval decision. Side effects and first-valid-resolution semantics remain in the existing implementation; this schema only validates the v4 boundary.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": { "$ref": "#/$defs/ApprovalResolveRequestFrame" },
    "response": { "$ref": "#/$defs/ApprovalResolveResponseFrame" }
  },
  "x-opensquilla-wire": {
    "protocol": "opensquilla-websocket-json",
    "version": 4,
    "compatibility": "exact-json-tree"
  },
  "x-opensquilla-codegen": {
    "python": { "tool": "datamodel-code-generator", "version": "0.75.1", "target": "pydantic_v2.BaseModel" },
    "typescript": { "tool": "json-schema-to-typescript", "version": "15.0.4" },
    "runtimeValidation": { "tool": "ajv", "version": "8.17.1", "mode": "standalone-adapter-only" }
  },
  "x-opensquilla-method": {
    "name": "exec.approval.resolve",
    "kind": "command",
    "scope": "operator.approvals",
    "guestAllowed": false,
    "idempotency": "idempotent",
    "timeout": { "policy": "caller" },
    "capability": { "kind": "method-availability", "name": "exec.approval.resolve" },
    "compatibilityAliases": ["plugin.approval.resolve"],
    "request": "#/$defs/ApprovalResolveRequestFrame",
    "params": "#/$defs/ApprovalResolveParams",
    "response": "#/$defs/ApprovalResolveResponseFrame",
    "result": "#/$defs/ApprovalResolveResult",
    "errors": [
      { "code": "INVALID_PARAMS" },
      { "code": "INVALID_REQUEST", "semantics": "missing-id-or-approved-or-cross-namespace" },
      { "code": "UNAUTHORIZED" },
      { "code": "NOT_FOUND", "semantics": "approval-id-does-not-exist" },
      { "code": "UNSUPPORTED_PARAM" },
      { "code": "STORAGE_BUSY", "retryable": true, "retryAfterMs": true, "details": true },
      { "code": "UNAVAILABLE", "retryable": true },
      { "code": "CONFLICT", "retryable": true },
      { "code": "INTERNAL_ERROR" }
    ]
  },
  "$defs": {
    "ApprovalResolveParams": {
      "description": "The exact v4 names are retained. choice/decision and the removed allowAlways/rememberIntent fields remain representable so an adapter can preserve legacy rejection semantics rather than silently dropping them.",
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "approved"],
      "properties": {
        "id": { "type": "string" },
        "approved": { "type": "boolean" },
        "choice": { "type": ["string", "null"] },
        "decision": { "type": ["string", "null"] },
        "allowAlways": { "type": ["boolean", "null"] },
        "rememberIntent": { "type": ["boolean", "null"] }
      }
    },
    "ApprovalResolveLegacyNonObjectParams": {
      "anyOf": [
        { "type": "array", "items": {} },
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "ApprovalResolveRequestFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "method"],
      "properties": {
        "type": { "const": "req" },
        "id": { "type": "string" },
        "method": { "enum": ["exec.approval.resolve", "plugin.approval.resolve"] },
        "params": {
          "anyOf": [
            { "$ref": "#/$defs/ApprovalResolveParams" },
            { "$ref": "#/$defs/ApprovalResolveLegacyNonObjectParams" },
            { "type": "null" }
          ]
        }
      }
    },
    "ApprovalResolveResult": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "mode", "approved", "resolved", "resolution", "deadline", "consumed", "pending"],
      "properties": {
        "id": { "type": "string" },
        "mode": { "type": "string", "enum": ["prompt", "auto-approve", "auto-deny"] },
        "approved": { "type": "boolean" },
        "resolved": { "type": "boolean" },
        "resolution": { "type": "string" },
        "deadline": { "type": ["number", "null"] },
        "consumed": { "type": "boolean" },
        "pending": { "type": "boolean" },
        "resolutionInProgress": { "type": ["boolean", "null"] }
      }
    },
    "RpcError": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": {},
        "retryable": { "type": ["boolean", "null"] },
        "retry_after_ms": { "type": ["integer", "null"], "minimum": 0 },
        "accepted": { "type": ["boolean", "null"] }
      }
    },
    "ApprovalResolveOkResponseFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "ok", "payload"],
      "properties": {
        "type": { "const": "res" },
        "id": { "type": "string" },
        "ok": { "const": true },
        "payload": { "$ref": "#/$defs/ApprovalResolveResult" },
        "error": { "type": "null" }
      }
    },
    "ApprovalResolveErrorResponseFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "ok", "error"],
      "properties": {
        "type": { "const": "res" },
        "id": { "type": "string" },
        "ok": { "const": false },
        "payload": { "type": "null" },
        "error": { "$ref": "#/$defs/RpcError" }
      }
    },
    "ApprovalResolveResponseFrame": {
      "oneOf": [
        { "$ref": "#/$defs/ApprovalResolveOkResponseFrame" },
        { "$ref": "#/$defs/ApprovalResolveErrorResponseFrame" }
      ]
    }
  }
}
