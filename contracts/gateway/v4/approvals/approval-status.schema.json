{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/approvals/approval-status.schema.json",
  "title": "OpenSquilla exec.approval.status Contract",
  "description": "Language-neutral Contract for reconnect-safe exec approval status. The plugin namespace uses the identical result shape and is declared as a v4 compatibility alias.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": { "$ref": "#/$defs/ApprovalStatusRequestFrame" },
    "response": { "$ref": "#/$defs/ApprovalStatusResponseFrame" }
  },
  "x-opensquilla-wire": {
    "protocol": "opensquilla-websocket-json",
    "version": 4,
    "compatibility": "exact-json-tree"
  },
  "x-opensquilla-codegen": {
    "python": { "tool": "datamodel-code-generator", "version": "0.75.1", "target": "pydantic_v2.BaseModel" },
    "typescript": { "tool": "json-schema-to-typescript", "version": "15.0.4" },
    "runtimeValidation": { "tool": "ajv", "version": "8.17.1", "mode": "standalone-adapter-only" }
  },
  "x-opensquilla-method": {
    "name": "exec.approval.status",
    "kind": "query",
    "scope": "operator.approvals",
    "guestAllowed": false,
    "lifecycle": "stable",
    "idempotency": "read-only",
    "timeout": { "policy": "caller" },
    "capability": { "kind": "method-availability", "name": "exec.approval.status" },
    "compatibilityAliases": ["plugin.approval.status"],
    "request": "#/$defs/ApprovalStatusRequestFrame",
    "params": "#/$defs/ApprovalStatusParams",
    "response": "#/$defs/ApprovalStatusResponseFrame",
    "result": "#/$defs/ApprovalStatusResult",
    "errors": [
      { "code": "INVALID_PARAMS" },
      { "code": "INVALID_REQUEST", "semantics": "missing-or-cross-namespace-id" },
      { "code": "UNAUTHORIZED" },
      { "code": "NOT_FOUND", "semantics": "legacy-handler-or-storage-lookup-error" },
      { "code": "STORAGE_BUSY", "retryable": true, "retryAfterMs": true, "details": true },
      { "code": "UNAVAILABLE", "retryable": true },
      { "code": "INTERNAL_ERROR" }
    ]
  },
  "$defs": {
    "ApprovalStatusParams": {
      "description": "The handler requires the exact v4 id key for object params. Legacy non-object values remain representable for observe-only validation.",
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "ApprovalStatusLegacyNonObjectParams": {
      "anyOf": [
        { "type": "array", "items": {} },
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "ApprovalStatusRequestFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "method"],
      "properties": {
        "type": { "const": "req" },
        "id": { "type": "string" },
        "method": { "enum": ["exec.approval.status", "plugin.approval.status"] },
        "params": {
          "anyOf": [
            { "$ref": "#/$defs/ApprovalStatusParams" },
            { "$ref": "#/$defs/ApprovalStatusLegacyNonObjectParams" },
            { "type": "null" }
          ]
        }
      }
    },
    "ApprovalStatusFoundResult": {
      "type": "object",
      "additionalProperties": true,
      "required": ["found", "id", "namespace", "pending", "resolutionInProgress", "resolved", "approved", "resolution", "consumed", "deadline"],
      "properties": {
        "found": { "const": true },
        "id": { "type": "string" },
        "namespace": { "enum": ["exec", "plugin"] },
        "pending": { "type": "boolean" },
        "resolutionInProgress": { "type": "boolean" },
        "resolved": { "type": "boolean" },
        "approved": { "type": "boolean" },
        "resolution": { "type": "string" },
        "consumed": { "type": "boolean" },
        "deadline": { "type": ["number", "null"] }
      }
    },
    "ApprovalStatusMissingResult": {
      "type": "object",
      "additionalProperties": true,
      "required": ["found", "id", "namespace", "pending", "resolutionInProgress", "resolved"],
      "properties": {
        "found": { "const": false },
        "id": { "type": "string" },
        "namespace": { "enum": ["exec", "plugin"] },
        "pending": { "const": false },
        "resolutionInProgress": { "const": false },
        "resolved": { "const": false }
      }
    },
    "ApprovalStatusResult": {
      "oneOf": [
        { "$ref": "#/$defs/ApprovalStatusFoundResult" },
        { "$ref": "#/$defs/ApprovalStatusMissingResult" }
      ]
    },
    "RpcError": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": {},
        "retryable": { "type": ["boolean", "null"] },
        "retry_after_ms": { "type": ["integer", "null"], "minimum": 0 },
        "accepted": { "type": ["boolean", "null"] }
      }
    },
    "ApprovalStatusOkResponseFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "ok", "payload"],
      "properties": {
        "type": { "const": "res" },
        "id": { "type": "string" },
        "ok": { "const": true },
        "payload": { "$ref": "#/$defs/ApprovalStatusResult" },
        "error": { "type": "null" }
      }
    },
    "ApprovalStatusErrorResponseFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "ok", "error"],
      "properties": {
        "type": { "const": "res" },
        "id": { "type": "string" },
        "ok": { "const": false },
        "payload": { "type": "null" },
        "error": { "$ref": "#/$defs/RpcError" }
      }
    },
    "ApprovalStatusResponseFrame": {
      "oneOf": [
        { "$ref": "#/$defs/ApprovalStatusOkResponseFrame" },
        { "$ref": "#/$defs/ApprovalStatusErrorResponseFrame" }
      ]
    }
  }
}
