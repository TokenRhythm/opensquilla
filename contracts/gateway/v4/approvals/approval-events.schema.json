{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/approvals/approval-events.schema.json",
  "title": "OpenSquilla approval lifecycle event Contract",
  "description": "Language-neutral Contract for the browser-safe v4 approval lifecycle projection. Producers redact policy internals before this boundary; aliases and unversioned legacy payloads remain accepted during migration.",
  "type": "object",
  "additionalProperties": false,
  "properties": { "payload": { "$ref": "#/$defs/ApprovalEventPayload" } },
  "x-opensquilla-wire": {
    "protocol": "opensquilla-websocket-json",
    "version": 4,
    "compatibility": "exact-json-tree"
  },
  "x-opensquilla-codegen": {
    "python": { "tool": "datamodel-code-generator", "version": "0.75.1", "target": "pydantic_v2.BaseModel" },
    "typescript": { "tool": "json-schema-to-typescript", "version": "15.0.4" },
    "runtimeValidation": { "tool": "ajv", "version": "8.17.1", "mode": "standalone-adapter-only" }
  },
  "x-opensquilla-event": {
    "name": "approval.events",
    "delivery": "live-only-best-effort",
    "schemaVersion": 1,
    "payload": "#/$defs/ApprovalEventPayload",
    "canonicalPayload": "#/$defs/ApprovalEventCanonicalPayload",
    "legacyPayload": "#/$defs/ApprovalEventLegacyPayload",
    "compatibility": "canonical-or-legacy",
    "legacyUnversioned": true,
    "wireNames": [
      "exec.approval.requested",
      "exec.approval.updated",
      "exec.approval.resolved",
      "plugin.approval.requested",
      "plugin.approval.updated",
      "plugin.approval.resolved"
    ],
    "redaction": "server-projected-display-only",
    "sequence": { "session": "payload.stream_seq", "connection": "frame.seq" }
  },
  "$defs": {
    "ApprovalEventIdentityPayload": {
      "description": "Common approval identity and display fields. The server projection is redacted before this boundary; event-specific additions remain open.",
      "type": "object",
      "additionalProperties": true,
      "anyOf": [
        { "required": ["approval_id"] },
        { "required": ["approvalId"] }
      ],
      "properties": {
        "approval_id": { "type": "string" },
        "approvalId": { "type": "string" },
        "namespace": { "enum": ["exec", "plugin"] },
        "session_key": { "type": "string" },
        "sessionKey": { "type": "string" },
        "tool_name": { "type": "string" },
        "toolName": { "type": "string" },
        "command": { "type": "string" },
        "approval_kind": { "type": "string" },
        "approvalKind": { "type": "string" },
        "agent": { "type": "string" },
        "args": { "type": ["object", "null"], "additionalProperties": true },
        "warning": { "type": "string" },
        "display_kind": { "type": "string" },
        "displayKind": { "type": "string" },
        "display_target": { "type": "string" },
        "displayTarget": { "type": "string" },
        "destructive": { "type": "boolean" },
        "irreversible": { "type": "boolean" },
        "backup_state": { "type": "string" },
        "backupState": { "type": "string" },
        "created_at": { "type": ["number", "null"] },
        "createdAt": { "type": ["number", "null"] },
        "deadline": { "type": ["number", "null"] },
        "approved": { "type": "boolean" },
        "resolution": { "type": "string" },
        "stream_seq": { "type": ["integer", "null"], "minimum": 0 },
        "streamSeq": { "type": ["integer", "null"], "minimum": 0 },
        "emitted_at": { "type": ["number", "null"] },
        "emittedAt": { "type": ["number", "null"] }
      }
    },
    "ApprovalEventPayload": {
      "description": "Approval lifecycle payload accepted by the adapter. It is either a versioned canonical payload or a legacy unversioned payload.",
      "oneOf": [
        { "$ref": "#/$defs/ApprovalEventCanonicalPayload" },
        { "$ref": "#/$defs/ApprovalEventLegacyPayload" }
      ]
    },
    "ApprovalEventCanonicalPayload": {
      "description": "Canonical approval lifecycle payload. New producers must set schema_version=1.",
      "allOf": [
        { "$ref": "#/$defs/ApprovalEventIdentityPayload" },
        {
          "type": "object",
          "required": ["schema_version"],
          "properties": { "schema_version": { "const": 1 } }
        }
      ]
    },
    "ApprovalEventLegacyPayload": {
      "description": "Legacy approval lifecycle payload. Existing v4 producers may omit schema_version or send it as null.",
      "allOf": [
        { "$ref": "#/$defs/ApprovalEventIdentityPayload" },
        {
          "type": "object",
          "properties": { "schema_version": { "type": "null" } }
        }
      ]
    }
  }
}
