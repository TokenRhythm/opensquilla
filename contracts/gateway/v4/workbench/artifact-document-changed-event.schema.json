{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/workbench/artifact-document-changed-event.schema.json",
  "title": "OpenSquilla Artifact Workbench document changed event Contract",
  "description": "Live best-effort document projection emitted after a Workbench mutation commits.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "x-opensquilla-wire": {
    "protocol": "opensquilla-websocket-json",
    "version": 4,
    "compatibility": "exact-json-tree"
  },
  "x-opensquilla-codegen": {
    "python": {
      "tool": "datamodel-code-generator",
      "version": "0.75.1",
      "target": "pydantic_v2.BaseModel"
    },
    "typescript": {
      "tool": "json-schema-to-typescript",
      "version": "15.0.4"
    },
    "runtimeValidation": {
      "tool": "ajv",
      "version": "8.17.1",
      "mode": "standalone-adapter-only"
    }
  },
  "x-opensquilla-event": {
    "name": "document.state_changed",
    "wireNames": [
      "document.state_changed",
      "session.event.artifact_state"
    ],
    "delivery": "live-only-best-effort",
    "schemaVersion": 1,
    "payload": "#/$defs/Payload",
    "compatibility": "canonical-or-legacy"
  },
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": true,
      "allOf": [
        {
          "anyOf": [
            { "required": ["documentId"] },
            { "required": ["document_id"] }
          ]
        },
        {
          "anyOf": [
            { "required": ["artifactEventSeq"] },
            { "required": ["artifact_event_seq"] }
          ]
        }
      ],
      "properties": {
        "documentId": { "type": "string", "minLength": 1 },
        "document_id": { "type": "string", "minLength": 1 },
        "artifactEventSeq": { "type": "integer", "minimum": 1 },
        "artifact_event_seq": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
