{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/meta/meta-inspect.schema.json",
  "title": "OpenSquilla meta.inspect Contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": {
      "$ref": "#/$defs/Request"
    },
    "response": {
      "$ref": "#/$defs/Response"
    }
  },
  "x-opensquilla-wire": {
    "protocol": "opensquilla-websocket-json",
    "version": 4,
    "compatibility": "exact-json-tree"
  },
  "x-opensquilla-codegen": {
    "python": {
      "tool": "datamodel-code-generator",
      "version": "0.75.1",
      "target": "pydantic_v2.BaseModel"
    },
    "typescript": {
      "tool": "json-schema-to-typescript",
      "version": "15.0.4"
    },
    "runtimeValidation": {
      "tool": "ajv",
      "version": "8.17.1",
      "mode": "standalone-adapter-only"
    }
  },
  "x-opensquilla-method": {
    "name": "meta.inspect",
    "kind": "query",
    "scope": "operator.read",
    "guestAllowed": false,
    "idempotency": "read-only",
    "timeout": {
      "policy": "caller"
    },
    "capability": {
      "kind": "method-availability",
      "name": "meta.inspect"
    },
    "request": "#/$defs/Request",
    "params": "#/$defs/Params",
    "response": "#/$defs/Response",
    "result": "#/$defs/Result",
    "errors": [
      {
        "code": "INVALID_REQUEST"
      },
      {
        "code": "UNAUTHORIZED"
      },
      {
        "code": "NOT_FOUND"
      },
      {
        "code": "INTERNAL_ERROR"
      }
    ]
  },
  "$defs": {
    "Params": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "instanceId": {
          "type": "string"
        },
        "instance_id": {
          "type": "string"
        },
        "installId": {
          "type": "string"
        },
        "install_id": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "method"
      ],
      "properties": {
        "type": {
          "const": "req"
        },
        "id": {
          "type": "string"
        },
        "method": {
          "const": "meta.inspect"
        },
        "params": {
          "anyOf": [
            {
              "$ref": "#/$defs/Params"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Result": {
      "oneOf": [
        {
          "$ref": "#/$defs/Inspection"
        },
        {
          "$ref": "#/$defs/Disabled"
        }
      ]
    },
    "RpcError": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "Ok": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "ok",
        "payload"
      ],
      "properties": {
        "type": {
          "const": "res"
        },
        "id": {
          "type": "string"
        },
        "ok": {
          "const": true
        },
        "payload": {
          "$ref": "#/$defs/Result"
        }
      }
    },
    "Err": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "ok",
        "error"
      ],
      "properties": {
        "type": {
          "const": "res"
        },
        "id": {
          "type": "string"
        },
        "ok": {
          "const": false
        },
        "payload": {
          "type": "null"
        },
        "error": {
          "$ref": "#/$defs/RpcError"
        }
      }
    },
    "Response": {
      "oneOf": [
        {
          "$ref": "#/$defs/Ok"
        },
        {
          "$ref": "#/$defs/Err"
        }
      ]
    },
    "Dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "available",
        "visibility",
        "invocation",
        "owners",
        "digest",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        },
        "visibility": {
          "type": "string"
        },
        "invocation": {
          "type": "string"
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "digest": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "Inspection": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "layer",
        "instance_id",
        "install_id",
        "ready",
        "status",
        "dependencies"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "instance_id": {
          "type": "string"
        },
        "install_id": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        },
        "invocation": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "generation": {
          "type": "integer"
        },
        "dependency_count": {
          "type": "integer",
          "minimum": 0
        },
        "ready": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "ready",
            "needs_setup"
          ]
        },
        "missing_bins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_env": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_provider_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_env_any": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "setup_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "manual_setup_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dependency"
          }
        }
      }
    },
    "Disabled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disabled"
      ],
      "properties": {
        "disabled": {
          "const": true
        }
      }
    }
  }
}
