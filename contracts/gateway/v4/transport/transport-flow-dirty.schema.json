{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/transport/transport-flow-dirty.schema.json",
  "title": "OpenSquilla transport.flow.dirty Contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "payload": {
      "$ref": "#/$defs/TransportFlowDirtyPayload"
    }
  },
  "x-opensquilla-wire": {
    "protocol": "opensquilla-websocket-json",
    "version": 4,
    "compatibility": "exact-json-tree"
  },
  "x-opensquilla-codegen": {
    "python": {
      "tool": "datamodel-code-generator",
      "version": "0.75.1",
      "target": "pydantic_v2.BaseModel"
    },
    "typescript": {
      "tool": "json-schema-to-typescript",
      "version": "15.0.4"
    },
    "runtimeValidation": {
      "tool": "ajv",
      "version": "8.17.1",
      "mode": "standalone-adapter-only"
    }
  },
  "x-opensquilla-event": {
    "name": "transport.flow.dirty",
    "delivery": "live-only-best-effort",
    "schemaVersion": 1,
    "payload": "#/$defs/TransportFlowDirtyPayload"
  },
  "$defs": {
    "TransportFlowDirtyPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_epoch",
        "dirty_keys",
        "global_dirty"
      ],
      "properties": {
        "delivery_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dirty_keys": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "global_dirty": {
          "type": "boolean"
        }
      }
    }
  }
}
