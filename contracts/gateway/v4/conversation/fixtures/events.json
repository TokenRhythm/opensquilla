{
  "cases": [
    {
      "id": "canonical-text",
      "coverage": "schema_version, canonical identity and session cursor",
      "wire": {
        "type": "event",
        "event": "session.event.text_delta",
        "seq": 12,
        "payload": {
          "schema_version": 1,
          "key": "agent:main:alpha",
          "task_id": "task-1",
          "turn_id": "turn-1",
          "stream_generation": "generation-a",
          "stream_seq": 7,
          "generation_epoch": 2,
          "text": "hello",
          "future_field": {"kept": true}
        },
        "meta": {"replayed": false}
      }
    },
    {
      "id": "legacy-thinking",
      "coverage": "legacy unversioned payload and camel-case aliases",
      "wire": {
        "event": "thinking",
        "payload": {
          "sessionKey": "agent:main:alpha",
          "taskId": "task-1",
          "turnId": "turn-1",
          "streamGeneration": "generation-a",
          "streamSeq": 8,
          "generationEpoch": 2,
          "text": "about to answer"
        }
      }
    },
    {
      "id": "legacy-suffixed-reset",
      "coverage": "historical versioned event name alias",
      "wire": {
        "event": "session.answer_generation_reset.v1",
        "payload": {
          "key": "agent:main:alpha",
          "old_generation_epoch": 1,
          "new_generation_epoch": 2
        }
      }
    },
    {
      "id": "task-lifecycle",
      "coverage": "task lifecycle event outside session.event namespace",
      "wire": {
        "event": "task.running",
        "payload": {
          "key": "agent:main:alpha",
          "task_id": "task-1",
          "status": "running"
        }
      }
    },
    {
      "id": "future-event",
      "coverage": "unknown additive event stays observable",
      "wire": {
        "event": "session.event.future_checkpoint",
        "payload": {
          "key": "agent:main:alpha",
          "schema_version": 1,
          "checkpoint": {"id": "c-1"}
        }
      }
    },
    {
      "id": "primitive-legacy-payload",
      "coverage": "legacy payload values are preserved without unsafe field access",
      "wire": {
        "event": "session.event.warning",
        "payload": null
      }
    },
    {
      "id": "legacy-explicit-null-fields",
      "coverage": "legacy payload may carry explicit nulls while retaining its wire shape",
      "wire": {
        "event": "session.event.state_change",
        "payload": {
          "schema_version": null,
          "sessionKey": "agent:main:alpha",
          "streamSeq": null,
          "state": null
        }
      }
    }
  ]
}
