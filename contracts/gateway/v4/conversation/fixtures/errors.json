{
  "cases": [
    {
      "id": "missing-event",
      "coverage": "event envelope must identify a conversation event",
      "wire": {"payload": {"key": "agent:main:alpha"}}
    },
    {
      "id": "wrong-frame-type",
      "coverage": "a response frame must not be decoded as an event",
      "wire": {
        "type": "res",
        "event": "session.event.text_delta",
        "payload": {}
      }
    },
    {
      "id": "unrelated-gateway-event",
      "coverage": "presence is not a conversation event",
      "wire": {"event": "presence", "payload": {}}
    },
    {
      "id": "unsupported-schema-version",
      "coverage": "future schema cannot be interpreted as v1",
      "wire": {
        "event": "session.event.text_delta",
        "payload": {"schema_version": 2, "key": "agent:main:alpha"}
      }
    },
    {
      "id": "conflicting-session-aliases",
      "coverage": "identity conflict must not cross-contaminate sessions",
      "wire": {
        "event": "session.event.text_delta",
        "payload": {
          "key": "agent:main:alpha",
          "session_key": "agent:main:beta"
        }
      }
    },
    {
      "id": "negative-stream-seq",
      "coverage": "replay cursor cannot move backwards through a negative value",
      "wire": {
        "event": "session.event.text_delta",
        "payload": {
          "key": "agent:main:alpha",
          "stream_seq": -1
        }
      }
    },
    {
      "id": "fractional-connection-seq",
      "coverage": "connection sequence must remain integral",
      "wire": {
        "event": "session.event.text_delta",
        "seq": 1.5,
        "payload": {}
      }
    },
    {
      "id": "malformed-meta",
      "coverage": "frame metadata keeps the v4 object/null shape",
      "wire": {
        "event": "session.event.text_delta",
        "meta": [],
        "payload": {}
      }
    }
  ]
}
