    "response": "#/$defs/SessionsSteerResponseFrame", "result": "#/$defs/SessionsSteerResult",
    "errors": [
      { "code": "INVALID_REQUEST" }, { "code": "UNAUTHORIZED" }, { "code": "NOT_FOUND" },
      { "code": "UNAVAILABLE", "retryable": true }, { "code": "INTERNAL_ERROR" }
    ]
  },
  "$defs": {
