{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/conversation/sessions-steer.schema.json",
  "title": "OpenSquilla sessions.steer Contract",
  "description": "Language-neutral Contract for the legacy same-turn steer compatibility method.",
  "type": "object", "additionalProperties": false,
