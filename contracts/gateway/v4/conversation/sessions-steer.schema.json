        "message": { "type": "string" },
        "client_message_id": { "type": ["string", "null"] }, "clientMessageId": { "type": ["string", "null"] },
        "surface_id": { "type": ["string", "null"] }, "surfaceId": { "type": ["string", "null"] },
        "_source": { "type": ["object", "null"], "additionalProperties": true }
      }
    },
