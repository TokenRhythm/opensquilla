{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/conversation/conversation-events.schema.json",
  "title": "OpenSquilla conversation event Contract",
  "description": "Language-neutral description of the v4 conversation event family. The v4 wire keeps event names in the envelope and payloads open for additive evolution; the decoder normalizes identity and replay metadata without changing the original JSON tree.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "frame": {
      "$ref": "#/$defs/ConversationEventFrame"
    }
  },
  "x-opensquilla-wire": {
    "protocol": "opensquilla-websocket-json",
    "version": 4,
    "compatibility": "exact-json-tree"
  },
  "x-opensquilla-codegen": {
    "python": {
      "tool": "datamodel-code-generator",
      "version": "0.75.1",
      "target": "pydantic_v2.BaseModel"
    },
    "typescript": {
      "tool": "json-schema-to-typescript",
      "version": "15.0.4"
    },
    "runtimeValidation": {
      "tool": "ajv",
      "version": "8.17.1",
      "mode": "standalone-adapter-only"
    }
  },
  "x-opensquilla-event": {
    "name": "conversation.events",
    "delivery": "live-only-best-effort",
    "schemaVersion": 1,
    "frame": "#/$defs/ConversationEventFrame",
    "canonicalPayload": "#/$defs/ConversationEventCanonicalPayload",
    "legacyPayload": "#/$defs/ConversationEventLegacyPayload",
    "compatibility": "canonical-or-legacy",
    "legacyUnversioned": true,
    "wireNames": [
      "chat.done",
      "session.epoch_changed",
      "session.event.answer_generation_reset",
      "session.event.approval_required",
      "session.event.artifact",
      "session.event.artifact_state",
      "session.event.collaboration_mode",
      "session.event.compaction",
      "session.event.cron_result",
      "session.event.done",
      "session.event.ensemble_progress",
      "session.event.error",
      "session.event.goal",
      "session.event.goal_run",
      "session.event.input_disposition",
      "session.event.meta_preflight",
      "session.event.meta_run_announced",
      "session.event.meta_run_completed",
      "session.event.meta_step_state",
      "session.event.plan_revision",
      "session.event.plan_run",
      "session.event.provider_activity",
      "session.event.router_control_replay",
      "session.event.router_decision",
      "session.event.run_heartbeat",
      "session.event.state_change",
      "session.event.steer",
      "session.event.subagent_completion",
      "session.event.task_group.done",
      "session.event.task_group.failed",
      "session.event.task_group.synthesizing",
      "session.event.task_group.waiting",
      "session.event.text_delta",
      "session.event.thinking",
      "session.event.thinking_end",
      "session.event.thinking_start",
      "session.event.tool_result",
      "session.event.tool_use_delta",
      "session.event.tool_use_end",
      "session.event.tool_use_start",
      "session.event.turn_committed",
      "session.event.warning",
      "task.abandoned",
      "task.cancelled",
      "task.failed",
      "task.queued",
      "task.running",
      "task.succeeded",
      "task.timeout"
    ],
    "sequence": {
      "connection": "frame.seq",
      "session": "payload.stream_seq",
      "generation": "payload.stream_generation"
    }
  },
  "$defs": {
    "ConversationEventFrame": {
      "title": "v4 conversation event frame",
      "description": "The decoder accepts known and future session/task event names. Unknown additive event names remain observable as an unknown event instead of being delivered to a typed handler.",
      "type": "object",
      "additionalProperties": true,
      "required": ["event"],
      "properties": {
        "type": {
          "const": "event"
        },
        "event": {
          "type": "string",
          "pattern": "^(?:chat\\.done|session\\.(?:epoch_changed|event(?:\\.[a-z0-9_]+)+)|task\\.[a-z0-9_]+)$"
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConversationEventCanonicalPayload"
            },
            {
              "$ref": "#/$defs/ConversationEventLegacyPayload"
            },
            {
              "not": {
                "type": "object"
              }
            }
          ]
        },
        "meta": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "seq": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "state_version": {
          "type": ["object", "null"],
          "additionalProperties": true
        }
      }
    },
    "ConversationEventPayload": {
      "title": "common conversation event payload",
      "description": "Common identity and replay fields are documented here; event-specific fields remain open so old and additive producers keep their exact payload.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "schema_version": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "key": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "session_key": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "sessionKey": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "stream_generation": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "streamGeneration": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "stream_seq": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "streamSeq": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "generation_epoch": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "generationEpoch": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "task_id": {
          "type": ["string", "null"]
        },
        "taskId": {
          "type": ["string", "null"]
        },
        "turn_id": {
          "type": ["string", "null"]
        },
        "turnId": {
          "type": ["string", "null"]
        },
        "emitted_at": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "emittedAt": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "ConversationEventCanonicalPayload": {
      "title": "canonical conversation event payload",
      "description": "Versioned conversation payload. Event-specific fields remain open, but canonical producers must carry schema_version=1.",
      "allOf": [
        {
          "$ref": "#/$defs/ConversationEventPayload"
        },
        {
          "type": "object",
          "required": ["schema_version"],
          "properties": {
            "schema_version": {
              "const": 1
            }
          }
        }
      ]
    },
    "ConversationEventLegacyPayload": {
      "title": "legacy conversation event payload",
      "description": "Older v4 producers omit schema_version. The decoder also retains primitive and null payloads as legacy values for exact wire compatibility.",
      "allOf": [
        {
          "$ref": "#/$defs/ConversationEventPayload"
        },
        {
          "type": "object",
          "anyOf": [
            {
              "not": {
                "required": ["schema_version"]
              }
            },
            {
              "properties": {
                "schema_version": {
                  "type": "null"
                }
              }
            }
          ]
        }
      ]
    }
  }
}
