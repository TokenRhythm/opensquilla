{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/conversation/turns-receipt-resolve.schema.json",
  "title": "OpenSquilla turns.receipt.resolve Contract",
  "description": "Atomically retire an unaccepted chat.send.v2 identity only within its original Gateway process epoch. Existing accepted or retired evidence remains readable across restarts; cross-epoch absence stays indeterminate. Historical chat.send requests cannot be retired.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": {
      "$ref": "#/$defs/TurnsReceiptResolveRequestFrame"
    },
    "response": {
      "$ref": "#/$defs/TurnsReceiptResolveResponseFrame"
    }
  },
  "x-opensquilla-wire": {
    "protocol": "opensquilla-websocket-json",
    "version": 4,
    "compatibility": "exact-json-tree"
  },
  "x-opensquilla-codegen": {
    "python": {
      "tool": "datamodel-code-generator",
      "version": "0.81.0",
      "target": "pydantic_v2.BaseModel"
    },
    "typescript": {
      "tool": "json-schema-to-typescript",
      "version": "16.0.0"
    },
    "runtimeValidation": {
      "tool": "ajv",
      "version": "8.20.0",
      "mode": "standalone-adapter-only"
    }
  },
  "x-opensquilla-method": {
    "name": "turns.receipt.resolve",
    "kind": "command",
    "scope": "operator.write",
    "guestAllowed": false,
    "idempotency": "idempotent",
    "timeout": {
      "policy": "caller"
    },
    "capability": {
      "kind": "method-availability",
      "name": "turns.receipt.resolve"
    },
    "request": "#/$defs/TurnsReceiptResolveRequestFrame",
