        "method"
      ],
      "properties": {
        "type": {
          "const": "req"
        },
        "id": {
          "type": "string"
        },
        "method": {
          "const": "sessions.send"
        },
        "params": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionsSendParams"
            },
            {
              "$ref": "#/$defs/SessionsSendLegacyNonObjectParams"
            },
            {
              "type": "null"
            }
          ]
        }
