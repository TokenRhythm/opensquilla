        "mime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "OfficeSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "kind"
      ],
      "description": "Renderer evidence only. Resolve against the pinned package; indexes and bounds never authorize writes.",
      "properties": {
        "format": {
          "enum": [
            "docx",
            "pptx",
            "xlsx"
          ]
        },
        "kind": {
          "enum": [
            "text",
            "element",
            "range"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 16384
