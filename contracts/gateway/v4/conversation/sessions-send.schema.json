        "name": {
          "type": "string",
          "maxLength": 256
        },
        "sheetName": {
          "type": "string",
          "maxLength": 256
        },
        "range": {
          "type": "string",
          "maxLength": 128
        },
        "pageIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "slideIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "sheetIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "pageIndexes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        },
        "slideIndexes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        },
        "paragraphIds": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "shapeIds": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "ranges": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "origin": {
          "enum": [
            "master",
            "layout",
            "slide",
            "unknown"
          ]
        },
        "elementType": {
          "enum": [
            "chart",
            "image",
            "picture",
            "shape",
            "table",
            "media",
            "group"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "story"
          ],
          "properties": {
            "story": {
              "enum": [
                "body",
                "header",
                "footer",
                "footnote",
                "endnote",
                "textbox"
              ]
            },
            "storyInstance": {
              "type": "string",
              "maxLength": 256
            },
            "path": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              }
            }
          }
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            "y": {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            "width": {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            "height": {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            "rotation": {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            "flipH": {
              "type": "boolean"
            },
            "flipV": {
              "type": "boolean"
            },
            "xPt": {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            "yPt": {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            "widthPt": {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            "heightPt": {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "xlsx"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "enum": [
                  "element",
                  "range"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "kind": {
                "enum": [
                  "text",
                  "element"
                ]
              }
            }
          }
        }
      ]
    },
    "TurnCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "args"
      ],
      "properties": {
        "name": {
          "const": "project.init"
        },
        "args": {
          "type": "string"
        }
      }
    }
  }
