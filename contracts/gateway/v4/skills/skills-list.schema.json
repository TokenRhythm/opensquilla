{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/skills/skills-list.schema.json",
  "title": "OpenSquilla skills.list Contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": { "$ref": "#/$defs/Request" },
    "response": { "$ref": "#/$defs/Response" }
  },
  "x-opensquilla-wire": {
    "protocol": "opensquilla-websocket-json",
    "version": 4,
    "compatibility": "exact-json-tree"
  },
  "x-opensquilla-codegen": {
    "python": { "tool": "datamodel-code-generator", "version": "0.75.1", "target": "pydantic_v2.BaseModel" },
    "typescript": { "tool": "json-schema-to-typescript", "version": "15.0.4" },
    "runtimeValidation": { "tool": "ajv", "version": "8.17.1", "mode": "standalone-adapter-only" }
  },
  "x-opensquilla-method": {
    "name": "skills.list",
    "kind": "query",
    "scope": "operator.read",
    "guestAllowed": false,
    "idempotency": "read-only",
    "timeout": { "policy": "caller" },
    "capability": { "kind": "method-availability", "name": "skills.list" },
    "request": "#/$defs/Request",
    "params": "#/$defs/Params",
    "response": "#/$defs/Response",
    "result": "#/$defs/Result",
    "errors": [
      { "code": "INVALID_REQUEST" },
      { "code": "UNAUTHORIZED" },
      { "code": "INTERNAL_ERROR" }
    ]
  },
  "$defs": {
    "Skill": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name"],
      "properties": { "name": { "type": "string" } }
    },
    "Params": {
      "type": "object",
      "additionalProperties": true,
      "properties": { "includeLifecycle": { "type": ["boolean", "null"] } }
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "method"],
      "properties": {
        "type": { "const": "req" },
        "id": { "type": "string" },
        "method": { "const": "skills.list" },
        "params": { "anyOf": [{ "$ref": "#/$defs/Params" }, { "type": "null" }] }
      }
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills"],
      "properties": { "skills": { "type": "array", "items": { "$ref": "#/$defs/Skill" } } }
    },
    "RpcError": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message"],
      "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
    },
    "Ok": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "ok", "payload"],
      "properties": {
        "type": { "const": "res" }, "id": { "type": "string" }, "ok": { "const": true },
        "payload": { "$ref": "#/$defs/Result" }
      }
    },
    "Err": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "ok", "error"],
      "properties": {
        "type": { "const": "res" }, "id": { "type": "string" }, "ok": { "const": false },
        "payload": { "type": "null" }, "error": { "$ref": "#/$defs/RpcError" }
      }
    },
    "Response": { "oneOf": [{ "$ref": "#/$defs/Ok" }, { "$ref": "#/$defs/Err" }] }
  }
}
