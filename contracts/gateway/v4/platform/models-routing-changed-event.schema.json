{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/platform/models-routing-changed-event.schema.json",
  "title": "OpenSquilla models.routing.changed event Contract",
  "description": "Live best-effort public model-routing projection for readable operator surfaces.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "payload": {
      "$ref": "#/$defs/ModelsRoutingChangedPayload"
    }
  },
  "x-opensquilla-wire": {
    "protocol": "opensquilla-websocket-json",
    "version": 4,
    "compatibility": "exact-json-tree"
  },
  "x-opensquilla-codegen": {
    "python": {
      "tool": "datamodel-code-generator",
      "version": "0.75.1",
      "target": "pydantic_v2.BaseModel"
    },
    "typescript": {
      "tool": "json-schema-to-typescript",
      "version": "15.0.4"
    },
    "runtimeValidation": {
      "tool": "ajv",
      "version": "8.17.1",
      "mode": "standalone-adapter-only"
    }
  },
  "x-opensquilla-event": {
    "name": "models.routing.changed",
    "delivery": "live-only-best-effort",
    "schemaVersion": 1,
    "payload": "#/$defs/ModelsRoutingChangedPayload"
  },
  "$defs": {
    "ModelsRoutingImageInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission",
        "reason"
      ],
      "properties": {
        "admission": {
          "enum": [
            "allowed",
            "blocked",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ModelsRoutingActivationPreview": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "selection_mode",
        "proposer_count",
        "member_providers",
        "candidates",
        "blocked_reason"
      ],
      "properties": {
        "selection_mode": {
          "type": "string"
        },
        "selection_configured": {
          "type": "boolean"
        },
        "proposer_count": {
          "type": "integer",
          "minimum": 0
        },
        "member_providers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "blocked_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ModelsRoutingModeCapabilities": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "image_input"
      ],
      "properties": {
        "image_input": {
          "$ref": "#/$defs/ModelsRoutingImageInput"
        }
      }
    },
    "ModelsRoutingCapabilitiesByMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct",
        "router",
        "ensemble"
      ],
      "properties": {
        "direct": {
          "$ref": "#/$defs/ModelsRoutingModeCapabilities"
        },
        "router": {
          "$ref": "#/$defs/ModelsRoutingModeCapabilities"
        },
        "ensemble": {
          "$ref": "#/$defs/ModelsRoutingModeCapabilities"
        }
      }
    },
    "ModelsRoutingChangedPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "mode",
        "router_enabled",
        "ensemble_enabled",
        "rollout_phase",
        "selection_mode",
        "selection_configured",
        "activation_preview",
        "router_required_by_ensemble",
        "image_input",
        "applies_to",
        "capabilities_by_mode",
        "source"
      ],
      "properties": {
        "mode": {
          "enum": [
            "direct",
            "router",
            "ensemble"
          ]
        },
        "router_enabled": {
          "type": "boolean"
        },
        "ensemble_enabled": {
          "type": "boolean"
        },
        "rollout_phase": {
          "type": "string"
        },
        "selection_mode": {
          "type": "string"
        },
        "selection_configured": {
          "type": "boolean"
        },
        "activation_preview": {
          "$ref": "#/$defs/ModelsRoutingActivationPreview"
        },
        "router_required_by_ensemble": {
          "type": "boolean"
        },
        "image_input": {
          "$ref": "#/$defs/ModelsRoutingImageInput"
        },
        "applies_to": {
          "const": "next_accepted_turn"
        },
        "capabilities_by_mode": {
          "$ref": "#/$defs/ModelsRoutingCapabilitiesByMode"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
