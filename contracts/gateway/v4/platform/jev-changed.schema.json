{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensquilla.dev/contracts/gateway/v4/platform/jev-changed.schema.json",
  "title": "OpenSquilla jev.changed event Contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "payload": {
      "$ref": "#/$defs/JevSnapshot"
    }
  },
  "x-opensquilla-wire": {
    "protocol": "opensquilla-websocket-json",
    "version": 4,
    "compatibility": "exact-json-tree"
  },
  "x-opensquilla-codegen": {
    "python": {
      "tool": "datamodel-code-generator",
      "version": "0.81.0",
      "target": "pydantic_v2.BaseModel"
    },
    "typescript": {
      "tool": "json-schema-to-typescript",
      "version": "16.0.0"
    },
    "runtimeValidation": {
      "tool": "ajv",
      "version": "8.20.0",
      "mode": "standalone-adapter-only"
    }
  },
  "$defs": {
    "JevSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "JevDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sessionKey",
        "action",
        "status",
        "current",
        "target",
        "reason",
        "evidence",
        "risk",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sessionKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "action": {
          "enum": [
            "switch",
            "review",
            "keep",
            "ensemble",
            "new_session"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "accepted",
            "dismissed",
            "applied",
            "expired"
          ]
        },
        "current": {
          "$ref": "#/$defs/JevSelection"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/JevSelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        },
        "evidence": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "createdAt": {
          "type": "number",
          "minimum": 0
        },
        "costHint": {
          "type": "string",
          "maxLength": 512
        },
        "trigger": {
          "type": "string",
          "maxLength": 128
        },
        "autoSwitchAt": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "enum": [
            "input",
            "loop"
          ]
        },
        "ensemble": {
          "$ref": "#/$defs/JevEnsemble"
        },
        "handoff": {
          "$ref": "#/$defs/JevHandoff"
        }
      }
    },
    "JevSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionKey",
        "enabled",
        "mode",
        "budgetPerHour",
        "model",
        "provider",
        "available",
        "status",
        "recommendation",
        "decisions"
      ],
      "properties": {
        "sessionKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "suggest",
            "trust"
          ]
        },
        "budgetPerHour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "available": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "ready",
            "checking",
            "unavailable",
            "disabled"
          ]
        },
        "recommendation": {
          "anyOf": [
            {
              "$ref": "#/$defs/JevDecision"
            },
            {
              "type": "null"
            }
          ]
        },
        "decisions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/JevDecision"
          }
        },
        "loopInterval": {
          "enum": [
            3,
            5
          ]
        },
        "autoSwitchSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "blocked": {
          "type": "boolean"
        },
        "draftId": {
          "type": "string",
          "maxLength": 128
        },
        "ensembleAvailable": {
          "type": "boolean"
        },
        "ensemblePlan": {
          "$ref": "#/$defs/JevEnsemble"
        },
        "contextRestartMinTurns": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000
        }
      }
    },
    "JevEnsemble": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "label",
        "strategy",
        "proposers",
        "aggregator",
        "configurationFingerprint"
      ],
      "properties": {
        "tier": {
          "const": "c4"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "strategy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "proposers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/JevSelection"
          }
        },
        "aggregator": {
          "$ref": "#/$defs/JevSelection"
        },
        "configurationFingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "JevHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSessionKey",
        "contextTokens",
        "contextWindowTokens"
      ],
      "properties": {
        "sourceSessionKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextTokens": {
          "type": "integer",
          "minimum": 0
        },
        "contextWindowTokens": {
          "type": "integer",
          "minimum": 0
        },
        "targetSessionKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "completedTurns": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "x-opensquilla-event": {
    "name": "jev.changed",
    "delivery": "live-only-best-effort",
    "schemaVersion": 1,
    "payload": "#/$defs/JevSnapshot"
  }
}
